# AirWard Federation - Backend Environment Configuration

# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (e.g. gemini-3.8-flash, gemini-2.5-flash, or gemini-1.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Allowed Frontend Origins for CORS (comma-separated or * for wildcard)
ALLOWED_ORIGINS=*

# HTTP Server Port (Cloud Run injects PORT=8080)
PORT=8080
